<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="View latest notices and announcements from Mother Teresa Public School, Mahnar.">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/header') %>

  <section class="page-header">
    <div class="container">
      <h1><i class="fas fa-clipboard-list me-3"></i>Notice Board</h1>
      <p>Stay updated with the latest school announcements</p>
      <div class="breadcrumb-custom">
        <a href="/">Home</a> <span>/</span> <span>Notices</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="row">
        <div class="col-lg-8 mx-auto">
          <% if (notices.length > 0) { %>
            <% notices.forEach(notice => { %>
              <div class="notice-card animate-on-scroll <%= notice.important ? 'important' : '' %>">
                <div class="d-flex justify-content-between align-items-start mb-2">
                  <h5 class="mb-0" style="font-family:var(--font-heading); font-size:1.1rem;">
                    <% if (notice.important) { %>
                      <i class="fas fa-exclamation-triangle me-2" style="color:var(--accent);"></i>
                    <% } else { %>
                      <i class="fas fa-bullhorn me-2" style="color:var(--secondary);"></i>
                    <% } %>
                    <%= notice.title %>
                  </h5>
                  <% if (notice.important) { %>
                    <span class="notice-badge">Important</span>
                  <% } %>
                </div>
                <p class="mb-3 text-muted" style="line-height:1.8;"><%= notice.content %></p>
                <div class="notice-date">
                  <i class="fas fa-calendar-alt"></i>
                  <%= notice.date.toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="text-center py-5">
              <i class="fas fa-bell-slash" style="font-size:4rem; color:var(--gray); opacity:0.3;"></i>
              <h4 class="mt-3 text-muted">No Notices Available</h4>
              <p class="text-muted">There are no notices at the moment. Please check back later.</p>
              <a href="/" class="btn btn-primary-custom mt-2">Back to Home</a>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
