<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <!-- Admin Sidebar -->
  <div class="admin-sidebar">
    <div class="sidebar-brand"><i class="fas fa-school me-2"></i> MTPS Admin</div>
    <ul class="nav flex-column">
      <li class="nav-item"><a class="nav-link" href="/admin/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
      <li class="nav-item"><a class="nav-link active" href="/admin/notices"><i class="fas fa-bullhorn"></i> Notices</a></li>
      <li class="nav-item"><a class="nav-link" href="/admin/gallery"><i class="fas fa-images"></i> Gallery</a></li>
      <li class="nav-item"><a class="nav-link" href="/admin/admissions"><i class="fas fa-user-graduate"></i> Admissions</a></li>
      <li class="nav-item"><a class="nav-link" href="/admin/messages"><i class="fas fa-envelope"></i> Messages</a></li>
      <li class="nav-item mt-3" style="border-top:1px solid rgba(255,255,255,0.1); padding-top:10px;">
        <a class="nav-link" href="/"><i class="fas fa-globe"></i> View Website</a>
      </li>
      <li class="nav-item"><a class="nav-link" href="/admin/logout" style="color:var(--accent) !important;"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
    </ul>
  </div>

  <div class="admin-content">
    <div class="admin-header">
      <div>
        <h3 style="font-family:var(--font-heading); margin-bottom:3px;">Manage Notices</h3>
        <p class="text-muted mb-0" style="font-size:0.88rem;">Add, edit, and delete school notices</p>
      </div>
    </div>

    <div class="row g-4">
      <!-- Add / Edit Notice Form -->
      <div class="col-lg-5">
        <div class="admin-table p-4">
          <h5 style="font-family:var(--font-heading); color:var(--primary); margin-bottom:20px;">
            <i class="fas fa-<%= editNotice ? 'edit' : 'plus-circle' %> me-2"></i>
            <%= editNotice ? 'Edit Notice' : 'Add New Notice' %>
          </h5>
          <form action="<%= editNotice ? '/admin/notices/edit/' + editNotice._id : '/admin/notices' %>" method="POST">
            <div class="mb-3">
              <label class="form-label fw-bold" style="font-size:0.9rem;">Title</label>
              <input type="text" class="form-control" name="title" required placeholder="Notice title" value="<%= editNotice ? editNotice.title : '' %>" style="border:2px solid var(--light-gray); padding:10px 14px;">
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold" style="font-size:0.9rem;">Content</label>
              <textarea class="form-control" name="content" rows="5" required placeholder="Notice content..." style="border:2px solid var(--light-gray); padding:10px 14px;"><%= editNotice ? editNotice.content : '' %></textarea>
            </div>
            <div class="mb-3 form-check">
              <input type="checkbox" class="form-check-input" name="important" id="importantCheck" <%= editNotice && editNotice.important ? 'checked' : '' %>>
              <label class="form-check-label" for="importantCheck">Mark as Important</label>
            </div>
            <button type="submit" class="btn btn-primary-custom w-100">
              <i class="fas fa-save me-2"></i><%= editNotice ? 'Update Notice' : 'Add Notice' %>
            </button>
            <% if (editNotice) { %>
              <a href="/admin/notices" class="btn btn-outline-secondary w-100 mt-2">Cancel Edit</a>
            <% } %>
          </form>
        </div>
      </div>

      <!-- Notices List -->
      <div class="col-lg-7">
        <div class="admin-table">
          <div class="table-responsive">
            <table class="table">
              <thead>
                <tr>
                  <th>Title</th>
                  <th>Date</th>
                  <th>Status</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% if (notices.length > 0) { %>
                  <% notices.forEach(n => { %>
                    <tr>
                      <td>
                        <strong><%= n.title %></strong>
                        <br><small class="text-muted"><%= n.content.substring(0, 60) %>...</small>
                      </td>
                      <td><%= n.date.toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %></td>
                      <td>
                        <% if (n.important) { %>
                          <span class="notice-badge">Important</span>
                        <% } else { %>
                          <span style="font-size:0.78rem; color:var(--gray);">Normal</span>
                        <% } %>
                      </td>
                      <td>
                        <a href="/admin/notices/edit/<%= n._id %>" class="btn btn-sm btn-outline-primary me-1" title="Edit">
                          <i class="fas fa-edit"></i>
                        </a>
                        <a href="/admin/notices/delete/<%= n._id %>" class="btn btn-sm btn-outline-danger" title="Delete" onclick="return confirm('Delete this notice?')">
                          <i class="fas fa-trash"></i>
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr><td colspan="4" class="text-center text-muted py-4">No notices yet. Add your first notice!</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
