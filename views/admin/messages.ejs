<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <!-- Admin Sidebar -->
  <div class="admin-sidebar">
    <div class="sidebar-brand"><i class="fas fa-school me-2"></i> MTPS Admin</div>
    <ul class="nav flex-column">
      <li class="nav-item"><a class="nav-link" href="/admin/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
      <li class="nav-item"><a class="nav-link" href="/admin/notices"><i class="fas fa-bullhorn"></i> Notices</a></li>
      <li class="nav-item"><a class="nav-link" href="/admin/gallery"><i class="fas fa-images"></i> Gallery</a></li>
      <li class="nav-item"><a class="nav-link" href="/admin/admissions"><i class="fas fa-user-graduate"></i> Admissions</a></li>
      <li class="nav-item"><a class="nav-link active" href="/admin/messages"><i class="fas fa-envelope"></i> Messages</a></li>
      <li class="nav-item mt-3" style="border-top:1px solid rgba(255,255,255,0.1); padding-top:10px;">
        <a class="nav-link" href="/"><i class="fas fa-globe"></i> View Website</a>
      </li>
      <li class="nav-item"><a class="nav-link" href="/admin/logout" style="color:var(--accent) !important;"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
    </ul>
  </div>

  <div class="admin-content">
    <div class="admin-header">
      <div>
        <h3 style="font-family:var(--font-heading); margin-bottom:3px;">Contact Messages</h3>
        <p class="text-muted mb-0" style="font-size:0.88rem;">View messages from the contact form</p>
      </div>
    </div>

    <div class="row g-3">
      <% if (messages.length > 0) { %>
        <% messages.forEach(msg => { %>
          <div class="col-lg-6">
            <div style="background:var(--white); border-radius:var(--radius-sm); padding:20px; box-shadow:var(--shadow-sm); border-left:4px solid <%= msg.read ? 'var(--gray)' : 'var(--primary)' %>;">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                  <h6 class="mb-1" style="font-family:var(--font-heading);">
                    <% if (!msg.read) { %>
                      <span style="width:8px; height:8px; border-radius:50%; background:var(--primary); display:inline-block; margin-right:5px;"></span>
                    <% } %>
                    <%= msg.subject %>
                  </h6>
                  <small class="text-muted">
                    <i class="fas fa-user me-1"></i><%= msg.name %>
                    &bull; <i class="fas fa-envelope me-1"></i><%= msg.email %>
                  </small>
                </div>
                <small class="text-muted"><%= msg.date.toLocaleDateString('en-IN', {day:'numeric',month:'short'}) %></small>
              </div>
              <p class="mb-3 text-muted" style="font-size:0.9rem; line-height:1.7;"><%= msg.message %></p>
              <div class="d-flex gap-2">
                <% if (!msg.read) { %>
                  <a href="/admin/messages/read/<%= msg._id %>" class="btn btn-sm btn-outline-success">
                    <i class="fas fa-check me-1"></i>Mark Read
                  </a>
                <% } else { %>
                  <span class="btn btn-sm btn-outline-secondary disabled"><i class="fas fa-check-double me-1"></i>Read</span>
                <% } %>
                <a href="/admin/messages/delete/<%= msg._id %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this message?')">
                  <i class="fas fa-trash me-1"></i>Delete
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div class="col-12 text-center py-5">
          <i class="fas fa-inbox" style="font-size:3rem; color:var(--gray); opacity:0.3;"></i>
          <p class="mt-3 text-muted">No messages yet</p>
        </div>
      <% } %>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
