<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <!-- Admin Sidebar -->
  <div class="admin-sidebar">
    <div class="sidebar-brand"><i class="fas fa-school me-2"></i> MTPS Admin</div>
    <ul class="nav flex-column">
      <li class="nav-item"><a class="nav-link" href="/admin/dashboard"><i class="fas fa-tachometer-alt"></i> Dashboard</a></li>
      <li class="nav-item"><a class="nav-link" href="/admin/notices"><i class="fas fa-bullhorn"></i> Notices</a></li>
      <li class="nav-item"><a class="nav-link active" href="/admin/gallery"><i class="fas fa-images"></i> Gallery</a></li>
      <li class="nav-item"><a class="nav-link" href="/admin/admissions"><i class="fas fa-user-graduate"></i> Admissions</a></li>
      <li class="nav-item"><a class="nav-link" href="/admin/messages"><i class="fas fa-envelope"></i> Messages</a></li>
      <li class="nav-item mt-3" style="border-top:1px solid rgba(255,255,255,0.1); padding-top:10px;">
        <a class="nav-link" href="/"><i class="fas fa-globe"></i> View Website</a>
      </li>
      <li class="nav-item"><a class="nav-link" href="/admin/logout" style="color:var(--accent) !important;"><i class="fas fa-sign-out-alt"></i> Logout</a></li>
    </ul>
  </div>

  <div class="admin-content">
    <div class="admin-header">
      <div>
        <h3 style="font-family:var(--font-heading); margin-bottom:3px;">Manage Gallery</h3>
        <p class="text-muted mb-0" style="font-size:0.88rem;">Upload and manage school photos</p>
      </div>
    </div>

    <div class="row g-4">
      <!-- Upload Form -->
      <div class="col-lg-4">
        <div class="admin-table p-4">
          <h5 style="font-family:var(--font-heading); color:var(--primary); margin-bottom:20px;">
            <i class="fas fa-cloud-upload-alt me-2"></i>Upload Photo
          </h5>
          <form action="/admin/gallery" method="POST" enctype="multipart/form-data">
            <div class="mb-3">
              <label class="form-label fw-bold" style="font-size:0.9rem;">Title</label>
              <input type="text" class="form-control" name="title" required placeholder="Photo title" style="border:2px solid var(--light-gray); padding:10px 14px;">
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold" style="font-size:0.9rem;">Category</label>
              <select class="form-select" name="category" style="border:2px solid var(--light-gray); padding:10px 14px;">
                <option value="School">School</option>
                <option value="Events">Events</option>
                <option value="Activities">Activities</option>
                <option value="Sports">Sports</option>
                <option value="Celebrations">Celebrations</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold" style="font-size:0.9rem;">Upload Image</label>
              <input type="file" class="form-control" name="image" accept="image/*" style="border:2px solid var(--light-gray); padding:10px 14px;">
              <small class="text-muted">Or provide an image URL below</small>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold" style="font-size:0.9rem;">Image URL (optional)</label>
              <input type="url" class="form-control" name="imageUrl" placeholder="https://example.com/photo.jpg" style="border:2px solid var(--light-gray); padding:10px 14px;">
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold" style="font-size:0.9rem;">Description</label>
              <textarea class="form-control" name="description" rows="2" placeholder="Brief description..." style="border:2px solid var(--light-gray); padding:10px 14px;"></textarea>
            </div>
            <button type="submit" class="btn btn-primary-custom w-100">
              <i class="fas fa-upload me-2"></i>Upload Photo
            </button>
          </form>
        </div>
      </div>

      <!-- Gallery Grid -->
      <div class="col-lg-8">
        <div class="row g-3">
          <% if (images.length > 0) { %>
            <% images.forEach(img => { %>
              <div class="col-md-4 col-6">
                <div style="background:var(--white); border-radius:var(--radius-sm); overflow:hidden; box-shadow:var(--shadow-sm);">
                  <div style="height:150px; overflow:hidden;">
                    <img src="<%= img.imageUrl %>" alt="<%= img.title %>" style="width:100%; height:100%; object-fit:cover;">
                  </div>
                  <div style="padding:12px;">
                    <h6 style="font-size:0.85rem; margin-bottom:3px;"><%= img.title %></h6>
                    <small class="text-muted"><%= img.category %></small>
                    <div class="mt-2">
                      <a href="/admin/gallery/delete/<%= img._id %>" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this photo?')">
                        <i class="fas fa-trash me-1"></i>Delete
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="col-12 text-center py-5">
              <i class="fas fa-camera" style="font-size:3rem; color:var(--gray); opacity:0.3;"></i>
              <p class="mt-3 text-muted">No photos yet. Upload your first photo!</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
