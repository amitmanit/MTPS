<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description"
    content="Contact Mother Teresa Public School, Mahnar. Get our address, phone, email, and send us a message.">
  <title>
    <%= title %>
  </title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>

<body>
  <%- include('partials/header') %>

    <section class="page-header">
      <div class="container">
        <h1><i class="fas fa-envelope me-3"></i>Contact Us</h1>
        <p>We'd love to hear from you. Get in touch!</p>
        <div class="breadcrumb-custom">
          <a href="/">Home</a> <span>/</span> <span>Contact</span>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="row g-4">
          <!-- Contact Info -->
          <div class="col-lg-5 animate-on-scroll">
            <div class="contact-info-card">
              <h4 style="font-family:var(--font-heading); color:var(--primary); margin-bottom:25px;">Get In Touch</h4>

              <div class="contact-info-item">
                <div class="icon-box"><i class="fas fa-map-marker-alt"></i></div>
                <div>
                  <h6 class="mb-1">Our Address</h6>
                  <p class="text-muted mb-0" style="font-size:0.9rem;">Congress Muhalla, Mahnar,<br>Vaishali, Bihar,
                    India</p>
                </div>
              </div>

              <div class="contact-info-item">
                <div class="icon-box"><i class="fas fa-phone-alt"></i></div>
                <div>
                  <h6 class="mb-1">Phone Number</h6>
                  <p class="text-muted mb-0" style="font-size:0.9rem;">+91-9801738505<br>+91-9572521074</p>
                </div>
              </div>

              <div class="contact-info-item">
                <div class="icon-box"><i class="fas fa-envelope"></i></div>
                <div>
                  <h6 class="mb-1">Email Address</h6>
                  <p class="text-muted mb-0" style="font-size:0.9rem;">
                    mtpsmahnar844506@gmail.com<br></p>
                </div>
              </div>

              <div class="contact-info-item">
                <div class="icon-box"><i class="fas fa-clock"></i></div>
                <div>
                  <h6 class="mb-1">Working Hours</h6>
                  <p class="text-muted mb-0" style="font-size:0.9rem;">
                    9:00 AM - 2:30 PM
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Contact Form -->
          <div class="col-lg-7 animate-on-scroll">
            <% if (success==='true' ) { %>
              <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fas fa-check-circle me-2"></i>
                <strong>Message Sent!</strong> Thank you for contacting us. We will get back to you soon.
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
              </div>
              <% } else if (success==='false' ) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                  <i class="fas fa-exclamation-circle me-2"></i>
                  <strong>Error!</strong> Please fill all required fields and try again.
                  <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                <% } %>

                  <div class="form-section">
                    <h4 style="font-family:var(--font-heading); color:var(--primary); margin-bottom:25px;">
                      <i class="fas fa-paper-plane me-2" style="color:var(--secondary);"></i>Send Us a Message
                    </h4>
                    <form action="/api/contact" method="POST" class="needs-validation" novalidate>
                      <div class="row g-3">
                        <div class="col-md-6">
                          <label class="form-label">Your Name <span class="text-danger">*</span></label>
                          <input type="text" class="form-control" name="name" required
                            placeholder="Enter your full name">
                        </div>
                        <div class="col-md-6">
                          <label class="form-label">Email Address <span class="text-danger">*</span></label>
                          <input type="email" class="form-control" name="email" required placeholder="your@email.com">
                        </div>
                        <div class="col-12">
                          <label class="form-label">Subject <span class="text-danger">*</span></label>
                          <input type="text" class="form-control" name="subject" required
                            placeholder="What is this regarding?">
                        </div>
                        <div class="col-12">
                          <label class="form-label">Message <span class="text-danger">*</span></label>
                          <textarea class="form-control" name="message" rows="5" required
                            placeholder="Type your message here..."></textarea>
                        </div>
                        <div class="col-12">
                          <button type="submit" class="btn btn-primary-custom">
                            <i class="fas fa-paper-plane me-2"></i>Send Message
                          </button>
                        </div>
                      </div>
                    </form>
                  </div>
          </div>
        </div>

        <!-- Google Map -->
        <div class="row mt-5">
          <div class="col-12 animate-on-scroll">
            <h4 class="text-center mb-4" style="font-family:var(--font-heading); color:var(--primary);">
              <i class="fas fa-map-marked-alt me-2" style="color:var(--secondary);"></i>Find Us on Map
            </h4>
            <div class="map-container">
              <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d14361.5!2d85.55!3d25.75!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39ed5f0b0b0b0b0b%3A0x0!2sMahnar%2C%20Bihar!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin"
                allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
                title="Mother Teresa Public School Location">
              </iframe>
            </div>
          </div>
        </div>
      </div>
    </section>

    <%- include('partials/footer') %>
      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
      <script src="/js/main.js"></script>
</body>

</html>