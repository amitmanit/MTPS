<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="View the photo gallery of Mother Teresa Public School - School events, activities, and campus photos.">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/header') %>

  <section class="page-header">
    <div class="container">
      <h1><i class="fas fa-images me-3"></i>Photo Gallery</h1>
      <p>Capturing moments of learning, fun, and growth</p>
      <div class="breadcrumb-custom">
        <a href="/">Home</a> <span>/</span> <span>Gallery</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <!-- Category Filter -->
      <div class="gallery-filter">
        <a href="/gallery?category=All" class="btn <%= selectedCategory === 'All' ? 'btn-primary' : 'btn-outline-primary' %>">All</a>
        <a href="/gallery?category=Events" class="btn <%= selectedCategory === 'Events' ? 'btn-primary' : 'btn-outline-primary' %>">Events</a>
        <a href="/gallery?category=School" class="btn <%= selectedCategory === 'School' ? 'btn-primary' : 'btn-outline-primary' %>">School</a>
        <a href="/gallery?category=Activities" class="btn <%= selectedCategory === 'Activities' ? 'btn-primary' : 'btn-outline-primary' %>">Activities</a>
        <a href="/gallery?category=Sports" class="btn <%= selectedCategory === 'Sports' ? 'btn-primary' : 'btn-outline-primary' %>">Sports</a>
        <a href="/gallery?category=Celebrations" class="btn <%= selectedCategory === 'Celebrations' ? 'btn-primary' : 'btn-outline-primary' %>">Celebrations</a>
      </div>

      <div class="row g-3">
        <% if (galleryImages.length > 0) { %>
          <% galleryImages.forEach(img => { %>
            <div class="col-lg-4 col-md-6 animate-on-scroll">
              <div class="gallery-item">
                <img src="<%= img.imageUrl %>" alt="<%= img.title %>" loading="lazy">
                <div class="gallery-overlay">
                  <h6><%= img.title %></h6>
                  <small><%= img.category %> &bull; <%= img.date.toLocaleDateString('en-IN', { month: 'short', year: 'numeric' }) %></small>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="col-12 text-center py-5">
            <i class="fas fa-camera" style="font-size:4rem; color:var(--gray); opacity:0.3;"></i>
            <h4 class="mt-3 text-muted">No photos in this category yet</h4>
            <p class="text-muted">Check back soon for updates!</p>
            <a href="/gallery?category=All" class="btn btn-primary-custom mt-2">View All Photos</a>
          </div>
        <% } %>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
